# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
.env.*.local

# Editor directories
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local admin/microsite (not committed)
admin/
data/.backups/

# Drafts being workshopped offline — content lives in data/site-content.json
# once it's ready to ship.
docs/

# Local dev toolbar — loaded only when the hostname is localhost (see the tail
# of js/site.js). Never committed, so it lives on whichever machine created it.
dev/

# Transient: scripts/inline-content.js parks files under this suffix while a
# deploy is in flight. Only ever on disk if a ship was interrupted, and
# `inline-content.js --revert` puts them back.
*.parked

# Wrangler local state
.wrangler/

# Lighthouse reports (local audit output)
lighthouse/


# Python bytecode cache — scripts/subset-font.py is run through uv, and
# importing it (the build does, to reach its assertions) leaves this behind.
__pycache__/
*.pyc

# Worktrees created under .claude/ are checkouts of this same repo, not
# content. git add -A will otherwise commit one as an embedded gitlink.
.claude/worktrees/
